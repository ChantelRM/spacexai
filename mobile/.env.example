# Copy to .env and set your API address. Never put secrets here: EXPO_PUBLIC_ values ship inside the app.
# Android emulator: http://10.0.2.2:8000/api/v1
# iOS simulator / web: http://127.0.0.1:8000/api/v1
# Physical phone on Wi-Fi: http://<your computer LAN IP>:8000/api/v1 (add that IP to backend ALLOWED_HOSTS)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
