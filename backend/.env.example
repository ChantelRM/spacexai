# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional. Defaults to SQLite at backend/db.sqlite3.
# DATABASE_URL=postgres://user:password@localhost:5432/coop

# Grok via xAI (server-side only; never ship this to the mobile app)
XAI_API_KEY=xai-your-key-here
# Pick a current model from https://docs.x.ai (e.g. a grok-4.x model)
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=30
XAI_MAX_RETRIES=2
